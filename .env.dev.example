# DEV stack (docker-compose.dev-server.yml) — copy to .env.dev and fill in.
# Must differ from production: separate database, separate signing keys.
DEV_DB_USER=bsmarker
DEV_DB_PASSWORD=change-me
DEV_DB_NAME=bsmarker_dev
DEV_REDIS_PASSWORD=change-me
DEV_MINIO_ACCESS_KEY=change-me
DEV_MINIO_SECRET_KEY=change-me
DEV_SECRET_KEY=change-me
DEV_JWT_SECRET_KEY=change-me
DEV_ADMIN_EMAIL=admin@dev.local
DEV_ADMIN_PASSWORD=change-me
# Every user copied from production gets this password in DEV.
DEV_USER_PASSWORD=change-me
# Must match production, otherwise the frontend bakes in https://localhost/dev/api/v1.
DOMAIN=bsmarker.utia.cas.cz
