# Multi-stage build for production backend with aggressive caching
# Compatible with both BuildKit and legacy builder

# ============================================
# Stage 1: Dependencies builder (Heavily cached)
# ============================================
FROM python:3.11-slim AS deps

# Install build dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy only requirements for better caching
COPY requirements.txt .

# Install Python dependencies
# Note: Remove --mount for compatibility with legacy builder
RUN pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# ============================================
# Stage 2: Production runtime
# ============================================
FROM python:3.11-slim AS runner

# Install runtime dependencies only
RUN apt-get update && apt-get install -y \
    libpq-dev \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r bsmarker && useradd -r -g bsmarker bsmarker

# Copy virtual environment from deps stage
COPY --from=deps /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Set working directory
WORKDIR /app

# Copy application code
COPY --chown=bsmarker:bsmarker . .

# Create necessary directories for logs and cache
RUN mkdir -p /app/logs /tmp/librosa_cache /tmp/matplotlib_cache /tmp/numba_cache && \
    chown -R bsmarker:bsmarker /app/logs /tmp/librosa_cache /tmp/matplotlib_cache /tmp/numba_cache

# Set environment variables for cache directories
ENV LIBROSA_CACHE_DIR=/tmp/librosa_cache
ENV MPLCONFIGDIR=/tmp/matplotlib_cache
ENV NUMBA_CACHE_DIR=/tmp/numba_cache
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Switch to non-root user
USER bsmarker

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# Run with gunicorn for production
CMD ["gunicorn", "app.main:app", "--config", "/app/gunicorn.conf.py"]
